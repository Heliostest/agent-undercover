# 多数供应商的 API Key 在页面「模型设置」里填，
# 随 POST /api/games 的请求体进入该局 session 内存，不写盘、不写日志。
# 本地 OmniRoute（provider=omniroute）例外：页面免填 Key，用下面两项（Key 可空）。

# 设为 true 才开放上帝视角接口 GET /api/games/<gameId>/reveal
ENABLE_GOD_VIEW=false

# 本地 OmniRoute（默认连跑 Next 的那台机器上的 OmniRoute）
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
